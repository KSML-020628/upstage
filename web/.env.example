NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Without this, /api/chat silently drops the cost/housing/language/deadline
# fact tables and falls back to only ui_profile_json -- the chatbot still
# answers, just with much thinner evidence, and nothing tells you it happened.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

UPSTAGE_API_KEY=your-server-only-upstage-key
UPSTAGE_CHAT_MODEL=solar-pro3

# "shadow" (default) calls the Solar planner on every request but discards its
# output and filters using the regex-based detectConstraints() instead --
# useful for comparing the two without affecting real answers, but costs a
# Solar call for no effect. "active" applies the planner's parsed conditions.
SOLAR_PLANNER_MODE=shadow

# solar-pro3 reasoning_effort for the planner/reasoner Solar calls: minimal
# (default, reasoning disabled) | low (disabled) | medium/high (reasoning on).
#
# WARNING, verified against the live API: reasoning tokens are drawn from the
# same max_tokens budget as query-plan.ts/reasoner.ts's max_tokens (900/1000).
# At reasoning_effort=medium, a real planner prompt consumed 899/900 tokens on
# reasoning alone and returned empty content (finish_reason: "length") --
# planner_failed/reasoner_failed on every request, silently falling back to
# the deterministic templates. Reasoning token usage also varies call to call
# at the same effort level (383 vs 899 tokens seen for the same prompt), so
# this isn't a one-time edge case. Do not set this above "minimal" without
# also raising max_tokens in both files by a wide margin and re-testing --
# and even then, no answer-quality benefit has been measured yet to justify
# the added cost/latency.
SOLAR_REASONING_EFFORT=minimal

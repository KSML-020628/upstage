# Client-readable Supabase config. NEXT_PUBLIC_SUPABASE_URL/PUBLISHABLE_KEY
# are the primary names this project uses; SUPABASE_URL and
# NEXT_PUBLIC_SUPABASE_ANON_KEY/SUPABASE_ANON_KEY are accepted fallbacks
# (see app/lib/supabase.ts) for Supabase projects that only expose the
# older "anon key" naming.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-only key used by app/lib/chat/supabase-facts.ts to read the
# structured cost_facts/housing_facts/language_requirements/
# application_deadlines/extracted_facts tables. Without it, /api/chat logs a
# warning and falls back to only the thinner ui_profile_json rows -- the
# chatbot still answers, just with much less evidence. SUPABASE_SERVICE_KEY
# and SUPABASE_KEY are accepted fallback names.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

UPSTAGE_API_KEY=your-server-only-upstage-key
UPSTAGE_CHAT_MODEL=solar-pro3

# "active" (default) applies the Solar planner's parsed conditions to the
# search. "shadow" skips the planner call entirely and searches on the
# regex-based detectConstraints() result alone -- use it only if you want
# zero Solar cost for query planning. (Previously "shadow" was the default
# and still called the planner on every request without using the result --
# full Solar cost for zero effect on the answer. Fixed 2026-07-23.)
SOLAR_PLANNER_MODE=active

# solar-pro3 reasoning_effort for the planner/reasoner Solar calls: minimal
# (default, reasoning disabled) | low (disabled) | medium/high (reasoning on).
#
# WARNING, verified against the live API: reasoning tokens are drawn from the
# same max_tokens budget as query-plan.ts/reasoner.ts's max_tokens (currently
# 16,000/20,000). At reasoning_effort=medium with the old, smaller max_tokens
# budget (900/1,000), a real planner prompt consumed 899/900 tokens on
# reasoning alone and returned empty content (finish_reason: "length") --
# planner_failed/reasoner_failed on every request, silently falling back to
# the deterministic templates. Even with max_tokens raised, reasoning_effort=
# high repeatedly exceeded a 90s timeout on the planner and fell back anyway,
# and reasoning token usage varies call to call at the same effort level even
# at temperature 0 (383 vs 899 tokens seen for the same prompt) -- see
# docs/solar_usage.md for the full measurements. No answer-quality benefit
# has been measured to justify the added cost/latency. Do not raise this
# above "minimal" without re-measuring end-to-end latency and re-deriving the
# AbortSignal.timeout / vercel.json maxDuration budget in docs/solar_usage.md
# -- those numbers assume "minimal".
SOLAR_REASONING_EFFORT=minimal
